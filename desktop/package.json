{
  "name": "simply-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "npm --prefix ../ui run build && node scripts/build.mjs",
    "start": "npm run build && node scripts/run.mjs dist/main.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "pack": "npm run build && node scripts/dist.mjs --dir",
    "dist": "npm run build && node scripts/dist.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0",
    "typescript": "^7.0.2"
  },
  "description": "Beberapa agent AI dengan UI kanvas",
  "author": {
    "name": "Simply Agent",
    "email": "noreply@example.invalid"
  },
  "homepage": "https://example.invalid/simply-agent",
  "build": {
    "appId": "dev.local.simply-agent",
    "productName": "simply-agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!dist/main.smoke.mjs",
      "!node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl{,/**}",
      "!node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64-musl{,/**}"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "linux": {
      "target": "deb",
      "category": "Development",
      "icon": "assets/icon.png",
      "executableName": "simply-agent",
      "maintainer": "Simply Agent <noreply@example.invalid>",
      "synopsis": "Beberapa agent AI dengan UI kanvas",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Simply Agent",
          "Comment": "Beberapa agent AI dengan UI kanvas",
          "Keywords": "ai;agent;claude;",
          "StartupWMClass": "simply-agent"
        }
      }
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "devel"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "Simply-Agent-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Simply Agent"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "Simply-Agent-${version}-mac-${arch}.${ext}"
    }
  },
  "desktopName": "simply-agent.desktop"
}
